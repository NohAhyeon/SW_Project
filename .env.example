# ── 노인 맞춤 대화 엔진 (elder_engine.py) 설정 예시 ──
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋 금지)

# LLM 사용 순서: 앞에서부터 시도하고, 실패하면 다음으로 넘어감
#   local,cloud = 파이 로컬 우선 + 안 되면 클라우드 (하이브리드, 권장)
#   cloud       = 클라우드만 / local = 로컬만 (완전 오프라인 시연)
LLM_ORDER=local,cloud

# 라즈베리파이 llama.cpp 서버 (llama-server --host 0.0.0.0 --port 8080 -m qwen2.5-1.5b-instruct-q4_k_m.gguf)
LOCAL_LLM_URL=http://<파이IP>:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct
LOCAL_LLM_TIMEOUT=25

# 클라우드: GROQ_API_KEY 가 있으면 Groq, 없으면 Gemini 사용
GEMINI_API_KEY=
# GROQ_API_KEY=
# CLOUD_LLM_MODEL=gemini-3.5-flash-lite
CLOUD_LLM_TIMEOUT=10

# 날씨 (비워두면 flutter_app/.env 의 값을 사용)
# WEATHER_API_KEY=
